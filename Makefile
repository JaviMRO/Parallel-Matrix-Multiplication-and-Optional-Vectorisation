# Mirror of build.ps1 for systems with GNU make (e.g. Linux, MSYS2 with make).
# build.ps1 is the build script actually used on the benchmark machine; keep
# both in sync. Same optimisation flags for every unit; -fopenmp only where
# OpenMP is used (matmul_seq.c / matmul_naive.c refuse to compile with it).

# VARIANT=scalar (default, build/) or VARIANT=simd (build/simd/, auto-vectorised
# for the host ISA). With -std=c11 gcc defaults to -ffp-contract=off (no FMA
# contraction; checked by scripts/collect_vec_evidence.ps1).
VARIANT  ?= scalar
CC       := gcc
WARN     := -std=c11 -Wall -Wextra -Wpedantic
ifeq ($(VARIANT),simd)
  CFLAGS := -O3 -march=native $(WARN)
  BUILD  := build/simd
else
  CFLAGS := -O3 -fno-tree-vectorize $(WARN)
  BUILD  := build
endif
OMPFLAGS := -fopenmp

ifeq ($(OS),Windows_NT)
  # -static: no dependency on the MSYS2 bin directory being on PATH
  LDLIBS := -static -lpsapi
  EXE    := .exe
else
  LDLIBS :=
  EXE    :=
endif

SRC   := src

OBJS_SEQ := $(BUILD)/matmul_seq.o $(BUILD)/matmul_naive.o $(BUILD)/inputs.o $(BUILD)/timing.o \
            $(BUILD)/affinity.o
OBJS_OMP := $(BUILD)/matmul_omp.o
OBJS     := $(OBJS_SEQ) $(OBJS_OMP)

PROGRAMS := $(if $(wildcard $(SRC)/test.c),$(BUILD)/test$(EXE)) \
            $(if $(wildcard $(SRC)/bench.c),$(BUILD)/bench$(EXE))

.PHONY: all clean
all: $(OBJS) $(PROGRAMS)

$(BUILD):
	mkdir -p $(BUILD)

# Each VARIANT has its own BUILD directory, so objects and headers never mix.
$(BUILD)/build_info.h: Makefile | $(BUILD)
	printf '/* Generated by the Makefile - do not edit. */\n#ifndef BUILD_INFO_H\n#define BUILD_INFO_H\n#define MATMUL_COMPILER  "gcc %s"\n#define MATMUL_CFLAGS    "$(CFLAGS)"\n#define MATMUL_OMP_FLAGS "$(OMPFLAGS)"\n#endif\n' "$$($(CC) -dumpfullversion)" > $@

$(OBJS_SEQ): $(BUILD)/%.o: $(SRC)/%.c $(wildcard $(SRC)/*.h) | $(BUILD)
	$(CC) $(CFLAGS) -c $< -o $@

$(OBJS_OMP): $(BUILD)/%.o: $(SRC)/%.c $(wildcard $(SRC)/*.h) | $(BUILD)
	$(CC) $(CFLAGS) $(OMPFLAGS) -c $< -o $@

$(BUILD)/%$(EXE): $(SRC)/%.c $(OBJS) $(BUILD)/build_info.h
	$(CC) $(CFLAGS) $(OMPFLAGS) -I $(BUILD) $< $(OBJS) -o $@ $(LDLIBS)

clean:
	rm -f $(BUILD)/*.o $(BUILD)/*$(EXE) $(BUILD)/build_info.h
